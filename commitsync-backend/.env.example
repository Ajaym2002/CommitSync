# Server Configuration
NODE_ENV=development
PORT=8000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/commitsync
# Or MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/?appName=Cluster0

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=30d

# Prediction Engine
PREDICTION_ENGINE_URL=http://localhost:5000/api/predict

# CORS
CORS_ORIGIN=http://localhost:5173

# Risk Calculation
RISK_RECALCULATION_INTERVAL=*/30 * * * *

# Google Authentication
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Groq AI — Sub-task suggestion LLM
# Get your free key at: https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=qwen/qwen3.6-27b

# Gemini AI — Used for Insights Page recommendations
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Email / SMTP Settings (Required for OTP Registration)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password